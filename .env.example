SERVICE_NAME=user-management-service
SERVICE_VERSION=0.1.0
ENV=dev

HTTP_PORT=8080
GRPC_ADDR=:9090
ADVERTISE_HOST=host.docker.internal
HEALTH_PATH=/health

# --- Runtime DB (least-privilege: SELECT/INSERT/UPDATE/DELETE) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=svc_user_mgmt
DB_PASS=__SET_ME__
DB_NAME=user_management
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# --- Migration DB (root, DDL only at startup) ---
DB_ROOT_USER=root
DB_ROOT_PASS=__SET_ME__

# --- JWT ---
JWT_SECRET=__SET_ME__
JWT_EXPIRY_HOURS=24

# --- Upstream services ---
PROJECT_MANAGEMENT_URL=http://project-management-1:8080

# --- Consul (fail-fast=false) ---
CONSUL_ENABLED=true
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_HEALTH_INTERVAL=10s
